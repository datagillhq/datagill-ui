# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.

# ─── BetterAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL of this app (used by BetterAuth for redirect URLs).
BETTER_AUTH_URL=http://localhost:3001

# BetterAuth Postgres — matches auth-db service in docker-compose.yml
DATABASE_URL=postgres://datagill:secret@localhost:5433/datagill_auth

# ─── Social OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── DataGill Backend ──────────────────────────────────────────────────────────
# Search service base URL — matches datagill-core docker-compose port
NEXT_PUBLIC_API_URL=http://localhost:8082

# ─── Docker ────────────────────────────────────────────────────────────────────
# Password for the auth-db Postgres service (docker-compose.yml)
AUTH_DB_PASSWORD=secret
