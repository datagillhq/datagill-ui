{
  "name": "datagill-ui",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w apps/app",
    "build": "npm run build -w apps/app",
    "start": "npm run start -w apps/app",
    "typecheck": "npm run typecheck -w apps/app",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write . && npm run typecheck",
    "test": "npm run test -w apps/app",
    "test:watch": "npm run test:watch -w apps/app",
    "test:e2e": "npm run test:e2e -w apps/app",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "lefthook": "1.11.13"
  }
}
